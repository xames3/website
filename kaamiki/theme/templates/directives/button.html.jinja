{%- from "components/helpers.html.jinja" import km_id with context %}
{%- from "components/chevron.html.jinja" import km_chevron_icon -%}
{%- from "components/anchors.html.jinja" import km_anchors -%}
{%- set km_parts = ["km-button", km_look, km_extra, "reference external"] -%}
{%- set km_icon = [km_faicon, "km-button__icon"] -%}
{%- set km_after = km_icon + ["km-button__icon--icon-position-after"] -%}
{%- set km_side = "km-button-row--align-" ~ km_align -%}
{%- set km_row = ["km-button-row", km_side if km_align != "center"] -%}
{% block km_button %}
    <p class="{{ km_row|select|join(' ') }}">
        {{- km_anchors(km_ids) -}}
        <a class="{{ km_parts|select|join(' ') }}"
           {{ km_id(km_ids) }}
           href="{{ km_url }}"
           {{ km_anchor|xmlattr }}>
            <span>
                {%- if km_faicon and not km_faicon_after -%}
                    <span class="{{ km_icon|join(' ') }}"
                          aria-hidden="true"></span>
                {%- endif -%}
                {{ km_text }}
                {%- if km_faicon and km_faicon_after -%}
                    <span class="{{ km_after|join(' ') }}"
                          aria-hidden="true"></span>
                {%- endif -%}
                {%- if km_chevron -%}
                    {{ km_chevron_icon() }}
                {%- endif -%}
            </span>
        </a>
    </p>
{% endblock km_button %}
