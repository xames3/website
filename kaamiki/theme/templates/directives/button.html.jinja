{% block km_button %}
    <p class="km-button-row km-button-row--{{ km_align }}"
       {% if km_ids %}id="{{ km_ids[0] }}"{% endif %}>
        <a class="km-button {{ km_look }}{% if km_extra %} {{ km_extra }}{% endif %} reference external"
           href="{{ km_url }}"
           {{ km_anchor|xmlattr }}>
            <span>
                {%- if km_faicon and not km_faicon_after -%}
                    <span class="{{ km_faicon }}"
                          aria-hidden="true"></span>
                {%- endif -%}
                {{ km_text }}
                {%- if km_faicon and km_faicon_after -%}
                    <span class="{{ km_faicon }} km-icon-after"
                          aria-hidden="true"></span>
                {%- endif -%}
                {%- if km_chevron -%}
                    <svg class="km-chevron"
                         viewBox="0 0 16 16"
                         aria-hidden="true">
                        <g class="km-chevron-arrow">
                        <path class="km-chevron-shaft" d="M13 8H3" pathLength="1" />
                        <path d="M9 4l4 4-4 4" />
                        </g>
                    </svg>
                {%- endif -%}
            </span>
        </a>
    </p>
{% endblock km_button %}
