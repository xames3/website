{%- from "components/helpers.html.jinja"
import km_class, km_glyph, km_id with context %}
{%- from "components/anchors.html.jinja" import km_anchors -%}
{%- set km_shape = "aspect-ratio: %s; --km-ratio: calc(%s)" -%}
{%- set km_css = km_shape|format(kaamiki.directive.ratio, kaamiki.directive.ratio) if kaamiki.directive.ratio else none -%}
{% block km_youtube %}
    {%- set km_label = kaamiki.directive.caption or _("YouTube video") %}
    {%- set km_cue = _("Play video: %(title)s", title=km_label|striptags) %}
    <figure class="{{ km_class('km-media', kaamiki.directive.classes) }}"
            {{ km_id(kaamiki.directive.ids) }}>
        <div class="km-media__frame km-media__frame--ratio"
             {{ {"style": km_css}|xmlattr }}>
            {{- km_anchors(kaamiki.directive.ids) -}}
            {%- if kaamiki.directive.facade %}
                <a class="km-media__facade"
                   href="{{ kaamiki.directive.watch }}"
                   data-km-facade
                   data-km-facade-src="{{ kaamiki.directive.url }}&amp;color=white"
                   data-km-facade-title="{{ km_label|striptags|e }}"
                   data-km-facade-allow="{{ kaamiki.directive.allow }}"
                   data-km-facade-referrer="{{ kaamiki.directive.referrer }}">
                    <img src="{{ kaamiki.directive.still }}"
                         alt=""
                         width="480"
                         height="360"
                         loading="lazy" />
                    {{ km_glyph(kaamiki.directive.play, "km-media__facade-icon") }}
                    <span class="km-sr-only">{{ km_cue }}</span>
                </a>
            {%- else %}
                <iframe class="km-media__iframe"
                        src="{{ kaamiki.directive.url }}&amp;color=white"
                        title="{{ km_label|striptags|e }}"
                        loading="lazy"
                        referrerpolicy="{{ kaamiki.directive.referrer }}"
                        allow="{{ kaamiki.directive.allow }}"
                        allowfullscreen></iframe>
            {%- endif %}
        </div>
        {%- if kaamiki.directive.caption %}
            <figcaption class="km-media__caption">
                {{- kaamiki.directive.caption -}}
            </figcaption>
        {%- endif -%}
    </figure>
{% endblock km_youtube %}
