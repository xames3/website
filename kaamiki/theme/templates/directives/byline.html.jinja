{%- from "components/helpers.html.jinja"
    import km_glyph, km_id, km_tab with context %}
{%- from "components/anchors.html.jinja" import km_anchors -%}
{%- set km_side = "km-byline--align-" ~ kaamiki.directive.align -%}
{%- set km_base = ["km-byline", km_side if kaamiki.directive.align != "center"] -%}
{%- macro km_ticker(minutes) -%}
    {%- set km_ms = ([3, 2 + 0.7 * minutes]|min * 1000)|round|int -%}
    <span class="km-ticker"
          style="--km-motion-ticker: {{ km_ms }}ms">{{- minutes -}}</span>
{%- endmacro -%}
{%- macro km_reading() -%}
    <p class="km-byline__reading-time">
        {{ km_glyph(kaamiki.icons.roles.reading_time, "km-byline__reading-time-icon") }}
        {{- ngettext("%(num)s min read", "%(num)s mins read", kaamiki.directive.minutes, num=km_ticker(kaamiki.directive.minutes)) -}}
    </p>
{%- endmacro -%}
{%- macro km_lang() -%}
    <span class="km-byline__language">
        {{ km_glyph(kaamiki.icons.roles.language) }}
        <span lang="{{ kaamiki.directive.language.code }}">{{ kaamiki.directive.language.name }}</span>
    </span>
{%- endmacro -%}
{%- macro km_copy() -%}
    <button type="button"
            class="km-byline__copy km-tooltip"
            data-km-copy-url>
        {{ km_glyph(kaamiki.icons.roles.copy_url) }}
        <span>{{ _("Copy") }}</span>
    </button>
{%- endmacro -%}
{%- macro km_source() -%}
    <div class="km-byline__meta-group km-byline__meta-group--end">
        <a href="{{ kaamiki.directive.page_source }}"
           class="km-byline__source">
            {{ km_glyph(kaamiki.icons.roles.page_source) }}
            <span>{{- _("Show") -}}</span>
        </a>
    </div>
{%- endmacro -%}
{% block km_byline %}
    {%- set km_who = kaamiki.directive.name|d(kaamiki.site.project.author) %}
    {%- set km_items = [
        km_reading() if kaamiki.directive.reading_time,
        km_lang() if kaamiki.directive.language,
        km_copy() if kaamiki.directive.copy_url
    ]|select|list %}
    <div class="{{ (km_base + (kaamiki.directive.classes or [])|list)|select|join(' ') }}"
         {{ km_id(kaamiki.directive.ids) }}
         {{ kaamiki.directive.data|xmlattr }}
         data-km-search-skip>
        {%- set km_href = kaamiki.directive.target|d(kaamiki.site.project.source) %}
        {%- set km_linked = km_href and km_href != "#" %}
        <{{ "a" if km_linked else "div" }} {%- if km_linked %} href="{{ km_href }}" {{ km_tab(kaamiki.directive.new_tab) }} aria-label="{{ _('Check out %(name)s', name=km_who|striptags) }}" {%- endif %} class="km-byline__profile">
            {%- if kaamiki.directive.avatar %}
                <img class="km-byline__avatar"
                     src="{{ kaamiki.directive.avatar }}"
                     width="{{ kaamiki.directive.avatar_size|d(20) }}"
                     height="{{ kaamiki.directive.avatar_size|d(20) }}"
                     loading="lazy"
                     alt="" />
            {%- endif %}
            <p class="km-byline__name">
                {{- km_anchors(kaamiki.directive.ids) -}}
                {{- km_who -}}
            </p>
        </{{ "a" if km_linked else "div" }}>
        {%- if km_items or kaamiki.directive.page_source %}
            <div class="km-byline__meta">
                {%- if km_items %}
                    <div class="km-byline__meta-group">
                        {%- for km_item in km_items %}
                            <span class="km-byline__separator"
                                  aria-hidden="true"></span>
                            {{ km_item }}
                        {%- endfor %}
                    </div>
                {%- endif %}
                {%- if kaamiki.directive.page_source %}{{ km_source() }}{%- endif %}
            </div>
        {%- endif %}
    </div>
{% endblock km_byline %}
