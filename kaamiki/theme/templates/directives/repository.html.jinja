{%- from "components/helpers.html.jinja"
import km_class, km_glyph, km_id, km_tab with context %}
{%- from "components/anchors.html.jinja" import km_anchors -%}
{%- macro km_count(name, label, field, icon) -%}
    <p class="km-repository__{{ name }}"
       hidden>
        {{- km_glyph(icon) }}
        <span class="sr-only">{{ label }}</span>
        <span data-km-repository-count="{{ field }}"></span>
    </p>
{%- endmacro -%}
{% block km_repository %}
    <div class="{{ km_class('km-repository', km_classes) }}"
         {{ km_id(km_ids) }}
         data-km-repository="{{ km_project }}">
        <div class="km-repository__header">
            <a href="https://github.com/{{ km_project }}"
               {{ km_tab(km_new_tab) }}
               class="km-repository__name">
                {{- km_anchors(km_ids) -}}
                {{- km_glyph(km_fa_icons.repository_mark) -}}
                {{- km_project -}}
            </a>
            <div class="km-repository__details">
                {% if km_stars %}
                    {{ km_count("stars", _("Stars") , "stargazers_count",
                    km_fa_icons.repository_stars) }}
                {% endif %}
                {% if km_forks %}
                    {{ km_count("forks", _("Forks") , "forks_count",
                    km_fa_icons.repository_forks) }}
                {% endif %}
            </div>
        </div>
        {% if km_text %}<p class="km-repository__text">{{ km_text }}</p>{% endif %}
    </div>
{% endblock km_repository %}
