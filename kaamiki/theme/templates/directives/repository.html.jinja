{% block km_repository %}
    <div class="km-github-repository{% for km_class in km_classes %} {{ km_class }}{% endfor %}"
         {% if km_ids %}id="{{ km_ids[0] }}"{% endif %}
         data-km-repository="{{ km_project }}">
        <div class="km-github-repository__header">
            <a href="https://github.com/{{ km_project }}"
               {% if km_new_tab %}rel="{{ km_rel }}" target="_blank"{% endif %}
               class="km-github-repository__name">{{ km_project }}</a>
            <div class="km-github-repository__details">
                {% if km_stars %}
                    <p class="km-github-repository__stars"
                       hidden>
                        <span class="sr-only">{{ _("Stars") }}</span>
                        <span data-km-repository-count="stargazers_count"></span>
                    </p>
                {% endif %}
                {% if km_forks %}
                    <p class="km-github-repository__forks"
                       hidden>
                        <span class="sr-only">{{ _("Forks") }}</span>
                        <span data-km-repository-count="forks_count"></span>
                    </p>
                {% endif %}
            </div>
        </div>
        {% if km_text %}
            <p class="km-github-repository__text">{{ km_text }}</p>
        {% endif %}
    </div>
{% endblock km_repository %}
