{%- from "components/helpers.html.jinja"
    import km_class, km_glyph, km_id, km_tab with context %}
{%- from "components/anchors.html.jinja" import km_anchors -%}
{%- macro km_count(name, label, field, icon) -%}
    <p class="km-repository__{{ name }}"
       hidden>
        {{- km_glyph(icon) }}
        <span class="km-sr-only">{{ label }}</span>
        <span data-km-repository-count="{{ field }}"></span>
    </p>
{%- endmacro -%}
{% block km_repository %}
    <div class="{{ km_class('km-repository', kaamiki.directive.classes) }}"
         {{ km_id(kaamiki.directive.ids) }}
         data-km-repository="{{ kaamiki.directive.project }}">
        <div class="km-repository__header">
            <a href="https://github.com/{{ kaamiki.directive.project }}"
               {{ km_tab(kaamiki.directive.new_tab) }}
               class="km-repository__name">
                {{- km_anchors(kaamiki.directive.ids) -}}
                {{- km_glyph(kaamiki.icons.roles.repository_mark) -}}
                {{- kaamiki.directive.project -}}
            </a>
            <div class="km-repository__details">
                {% if kaamiki.directive.stars %}
                    {{ km_count("stars", _("Stars") , "stargazers_count",
                        kaamiki.icons.roles.repository_stars) }}
                {% endif %}
                {% if kaamiki.directive.forks %}
                    {{ km_count("forks", _("Forks") , "forks_count",
                        kaamiki.icons.roles.repository_forks) }}
                {% endif %}
            </div>
        </div>
        {% if kaamiki.directive.text -%}
            <p class="km-repository__text">{{ kaamiki.directive.text }}</p>
        {%- endif %}
    </div>
{% endblock km_repository %}
