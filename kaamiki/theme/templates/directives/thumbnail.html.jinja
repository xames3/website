{%- from "components/helpers.html.jinja"
import km_class, km_id, km_tab with context %}
{%- from "components/anchors.html.jinja" import km_anchors -%}
{%- set km_pic = "km-thumbnail__image" -%}
{%- set km_pics = [km_pic, km_pic ~ "--greyscale" if kaamiki.directive.greyscale] -%}
{%- set km_name = kaamiki.directive.title or _("YouTube video") -%}
{%- set km_alt = (kaamiki.directive.title|striptags) or _("YouTube video") -%}
{% block km_youtube_thumbnail %}
    <div class="{{ km_class('km-thumbnail', kaamiki.directive.classes) }}"
         {{ km_id(kaamiki.directive.ids) }}
         data-km-youtube-id="{{ kaamiki.directive.video_id }}"
         {{ "data-km-youtube-title" if kaamiki.directive.title }}
         {{ "data-km-youtube-channel" if kaamiki.directive.channel }}>
        {{- km_anchors(kaamiki.directive.ids) -}}
        <div class="km-thumbnail__body">
            {#- The title's link is the one a keyboard reaches, so this one
                is left out of the tab order. -#}
            <a href="{{ kaamiki.directive.src }}"
               {{ km_tab(kaamiki.directive.new_tab) }}
               tabindex="-1"
               class="{{ km_pics|select|join(' ') }}">
                {%- if kaamiki.directive.thumbnail %}
                    <img src="{{ kaamiki.directive.thumbnail }}"
                         alt="{{ km_alt }}"
                         width="480"
                         height="360"
                         loading="lazy" />
                {%- endif %}
            </a>
            <div class="km-thumbnail__content">
                <p class="km-thumbnail__title">
                    <a href="{{ kaamiki.directive.src }}"
                       {{ km_tab(kaamiki.directive.new_tab) }}>
                        {{- km_name -}}
                    </a>
                </p>
                <p class="km-thumbnail__channel">
                    {{- kaamiki.directive.channel or _("Watch on YouTube") -}}
                </p>
                {%- if kaamiki.directive.caption %}
                    <p class="km-thumbnail__caption">{{ kaamiki.directive.caption }}</p>
                {%- endif %}
            </div>
        </div>
    </div>
{% endblock km_youtube_thumbnail %}
