{% block km_youtube_thumbnail %}
    <a href="{{ km_src }}"
       {% if km_new_tab %}rel="{{ km_rel }}" target="_blank"{% endif %}
       class="km-youtube-card"
       data-km-youtube-id="{{ km_video_id }}"
       data-km-youtube-src="{{ km_src }}"
       {{ "data-km-private" if km_private }}
       {{ "data-km-youtube-title" if km_title }}
       {{ "data-km-youtube-channel" if km_channel }}>
        <article class="km-youtube-card__body">
            <div class="km-youtube-card__thumbnail{% if km_grayscale %} km-grayscale{% endif %}">
                {%- if km_thumbnail %}
                    <img src="{{ km_thumbnail }}"
                         alt=""
                         width="480"
                         height="360"
                         loading="lazy">
                {%- endif %}
            </div>
            <div class="km-youtube-card__content">
                <p class="km-youtube-card__title">{{ km_title or _("YouTube video") }}</p>
                <p class="km-youtube-card__channel">
                    {{- km_channel or _("Watch on YouTube") -}}
                </p>
            </div>
        </article>
    </a>
{% endblock km_youtube_thumbnail %}
