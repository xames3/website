{% block km_youtube_thumbnail %}
    <a href="{{ km_src }}"
       {% if km_new_tab %}rel="{{ km_rel }}" target="_blank"{% endif %}
       class="km-youtube-block{% for km_class in km_classes %} {{ km_class }}{% endfor %}"
       {% if km_ids %}id="{{ km_ids[0] }}"{% endif %}
       data-km-youtube-id="{{ km_video_id }}"
       {{ "data-km-private" if km_private }}
       {{ "data-km-youtube-title" if km_title }}
       {{ "data-km-youtube-channel" if km_channel }}>
        <article class="km-youtube-block__body">
            <div class="km-youtube-block__thumbnail{% if km_greyscale %} km-greyscale{% endif %}">
                {%- if km_thumbnail %}
                    <img src="{{ km_thumbnail }}"
                         alt=""
                         width="480"
                         height="360"
                         loading="lazy">
                {%- endif %}
            </div>
            <div class="km-youtube-block__content">
                <p class="km-youtube-block__title">{{ km_title or _("YouTube video") }}</p>
                <p class="km-youtube-block__channel">
                    {{- km_channel or _("Watch on YouTube") -}}
                </p>
            </div>
        </article>
    </a>
{% endblock km_youtube_thumbnail %}
