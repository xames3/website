{%- from "components/helpers.html.jinja"
import km_class, km_id, km_tab with context %}
{%- from "components/anchors.html.jinja" import km_anchors -%}
{%- set km_pic = "km-thumbnail__image" -%}
{%- set km_pics = [km_pic, km_pic ~ "--greyscale" if km_greyscale] -%}
{%- set km_name = km_title or _("YouTube video") -%}
{%- set km_alt = (km_title|striptags) or _("YouTube video") -%}
{% block km_youtube_thumbnail %}
    <div class="{{ km_class('km-thumbnail', km_classes) }}"
         {{ km_id(km_ids) }}
         data-km-youtube-id="{{ km_video_id }}"
         {{ "data-km-youtube-title" if km_title }}
         {{ "data-km-youtube-channel" if km_channel }}>
        {{- km_anchors(km_ids) -}}
        <div class="km-thumbnail__body">
            {#- The title's link is the one a keyboard reaches, so this one
                is left out of the tab order. -#}
            <a href="{{ km_src }}"
               {{ km_tab(km_new_tab) }}
               tabindex="-1"
               class="{{ km_pics|select|join(' ') }}">
                {%- if km_thumbnail %}
                    <img src="{{ km_thumbnail }}"
                         alt="{{ km_alt }}"
                         width="480"
                         height="360"
                         loading="lazy" />
                {%- endif %}
            </a>
            <div class="km-thumbnail__content">
                <p class="km-thumbnail__title">
                    <a href="{{ km_src }}"
                       {{ km_tab(km_new_tab) }}>
                        {{- km_name -}}
                    </a>
                </p>
                <p class="km-thumbnail__channel">
                    {{- km_channel or _("Watch on YouTube") -}}
                </p>
                {%- if km_caption %}
                    <p class="km-thumbnail__caption">{{ km_caption }}</p>
                {%- endif %}
            </div>
        </div>
    </div>
{% endblock km_youtube_thumbnail %}
