{%- from "components/helpers.html.jinja" import km_glyph with context %}
{%- set km_clock = km_fa_icons.release_date ~ " km-release__date-icon" -%}
{% block km_release %}
    {%- if km_date or km_titled %}
        <div class="km-release__meta">
            {%- if km_date %}
                <time class="km-release__date"
                      datetime="{{ km_datetime }}">
                {{ km_glyph(km_clock) }}{{ km_date }}</time>
            {%- endif %}
            {%- if km_titled %}
                <span class="km-release__version">{{ km_version }}</span>
            {%- endif %}
        </div>
    {%- endif %}
{% endblock km_release %}
