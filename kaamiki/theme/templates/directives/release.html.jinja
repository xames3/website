{%- from "components/helpers.html.jinja" import km_glyph with context %}
{%- set km_clock = kaamiki.icons.roles.release_date ~ " km-release__date-icon" -%}
{% block km_release %}
    {%- if kaamiki.directive.date or kaamiki.directive.titled %}
        <div class="km-release__meta">
            {%- if kaamiki.directive.date %}
                <time class="km-release__date"
                      datetime="{{ kaamiki.directive.datetime }}">
                {{ km_glyph(km_clock) }}{{ kaamiki.directive.date }}</time>
            {%- endif %}
            {%- if kaamiki.directive.titled %}
                <span class="km-release__version">{{ kaamiki.directive.version }}</span>
            {%- endif %}
        </div>
    {%- endif %}
{% endblock km_release %}
