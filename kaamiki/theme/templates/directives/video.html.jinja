{% block km_video %}
    <figure class="km-media km-media--video{% for km_class in km_classes %} {{ km_class }}{% endfor %}"
            {% if km_ids %}id="{{ km_ids[0] }}"{% endif %}>
        <div class="km-media__frame">
            <video class="km-media__video"
                   {{ km_player|xmlattr }}>
                {%- for source in km_sources %}
                    <source src="{{ source.url }}"
                            {% if source.type %}type="{{ source.type }}"{% endif %}>
                {%- endfor %}
                {%- for track in km_tracks %}
                    <track kind="captions"
                           src="{{ track.url }}"
                           srclang="{{ track.lang }}"
                           label="{{ track.label }}">
                {%- endfor %}
                {{ _("Your browser doesn't support the video tag.") }}
            </video>
            <i class="{{ km_fa_icons.play }} km-media__facade-icon km-media__play"
               aria-hidden="true"></i>
        </div>
        {%- if km_caption %}
            <figcaption class="km-media__caption">{{ km_caption }}</figcaption>
        {%- endif -%}
    </figure>
{% endblock km_video %}
