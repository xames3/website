{%- from "components/helpers.html.jinja" import km_glyph, km_id with context %}
{%- from "components/anchors.html.jinja" import km_anchors -%}
{%- set km_figure = ["km-media", "km-media--video"] + (km_classes or []) -%}
{% block km_video %}
    <figure class="{{ km_figure|join(' ') }}"
            {{ km_id(km_ids) }}>
        <div class="km-media__frame">
            {{- km_anchors(km_ids) -}}
            <video class="km-media__video"
                   {{ km_player|xmlattr }}>
                {%- for source in km_sources %}
                    <source src="{{ source.url }}"
                            {{ {"type": source.type or none}|xmlattr }} />
                {%- endfor %}
                {%- for track in km_tracks %}
                    <track kind="captions"
                           src="{{ track.url }}"
                           srclang="{{ track.lang }}"
                           label="{{ track.label }}" />
                {%- endfor %}
                {%- set km_download -%}
                    <a href="{{ km_sources[0].url }}"
                       download>{{- _("Download it") -}}</a>
                {%- endset %}
                {%- trans trimmed download=km_download %}
                This video won't play in your browser. {{ download }}.
            {%- endtrans %}
        </video>
        {{ km_glyph(km_fa_icons.play, "km-media__facade-icon km-media__play") }}
    </div>
    {%- if km_caption %}
        <figcaption class="km-media__caption">{{ km_caption }}</figcaption>
    {%- endif -%}
</figure>
{% endblock km_video %}
