{%- from "components/helpers.html.jinja" import km_glyph, km_tab with context %}
{%- from "components/logo.html.jinja" import km_logo, km_title with context -%}
{%- set km_search = hasdoc('search') and km_show_searchbox|tobool -%}
{%- macro km_links() -%}
    <p class="caption"
       role="heading"
       aria-level="2">
        <span class="caption-text">{{ _("External links") }}</span>
    </p>
    <ul class="km-sidebar__mobile-list">
        {%- for text, button in km_sidebar_buttons.items() %}
            {%- if button is mapping %}
                {%- set km_icon = button.icon or km_fa_icons.external_link %}
                <li>
                    <a href="{{ button.url }}"
                       title="{{ text|e }}"
                       {{ km_tab(button.new_tab) }}
                       class="km-sidebar__mobile-item"
                       {{ button.extras or '' }}>
                        {{ km_glyph(km_icon) }}
                        <span>{{ text|e }}</span>
                    </a>
                </li>
            {%- endif %}
        {%- endfor %}
    </ul>
{%- endmacro -%}
<aside id="km-sidebar"
       class="km-sidebar km-sidebar--primary">
    <noscript>
        <a class="km-sidebar__close"
           href="#km-content">{{ _("Close menu") }}</a>
    </noscript>
    <a href="{{ pathto(master_doc) }}"
       class="km-sidebar__brand">
        {{- km_logo() -}}
        <span class="km-sidebar__brand-title">{{ km_title() }}</span>
    </a>
    {%- if km_search %}
        <div class="km-sidebar__search">
            {%- include "components/searchbox.html.jinja" %}
        </div>
    {%- endif %}
    <div class="km-sidebar__scroll">
        <div class="km-sidebar__content">
            <nav class="km-sidebar__toc"
                 aria-label="{{ _('Table of contents') }}">
                {{ toctree(titles_only=km_toctree_titles_only,
                                collapse=true,
                                **km_toctree_args) }}
                {%- if km_sidebar_buttons|tobool %}{{ km_links() }}{%- endif %}
                </nav>
            </div>
        </div>
    </aside>
