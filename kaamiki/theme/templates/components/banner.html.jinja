{%- macro km_banner(km_found, km_mix="", km_lazy=false) -%}
    {%- set km_also = " " ~ km_mix if km_mix else "" -%}
    {%- if km_found.picture %}
        <div class="km-banner km-banner--picture{{ km_also }}"
             aria-hidden="true">
            <img class="km-banner__picture"
                 src="{{ km_found.picture|e }}"
                 alt=""
                 width="1200"
                 height="630"
                 {% if km_lazy %}loading="lazy"{% endif %}
                 decoding="async" />
        </div>
    {%- else %}
        <div class="km-banner km-banner--{{ km_found.shade }} km-banner--swirl-{{ km_found.swirl }}{{ km_also }}"
             aria-hidden="true">
            <span class="km-banner__swirl"></span>
            {%- if km_found.icon %}
                <span class="km-banner__icon {{ km_found.icon|e }}"></span>
            {%- endif %}
        </div>
    {%- endif %}
{%- endmacro -%}
