{%- if prev or next %}
    <nav class="km-pagination"
         aria-label="{{ _('Pagination') }}">
        {%- for page, modifier, label in [
            (prev, 'prev', _('Previous page')),
            (next, 'next', _('Next page'))
            ] %}
            {%- if page %}
                <a href="{{ page.link|e }}"
                   class="km-pagination__link km-pagination__link--{{ modifier }}">
                    <svg class="km-chevron"
                         viewBox="0 0 16 16"
                         aria-hidden="true">
                        <g class="km-chevron-arrow">
                        <path class="km-chevron-shaft" d="M13 8H3" pathLength="1" />
                        <path d="M9 4l4 4-4 4" />
                        </g>
                    </svg>
                    <span class="sr-only">{{ label }}</span>
                </a>
            {%- endif %}
        {%- endfor %}
    </nav>
{%- endif %}
