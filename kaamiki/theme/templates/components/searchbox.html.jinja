<form action="{{ pathto('search') }}"
      method="get"
      class="km-search">
    <label class="km-search__label">
        <span class="sr-only">{{ _('Search') }}</span>
        <input class="km-search__input"
               type="search"
               name="q"
               autocomplete="on"
               placeholder="{{ _('Search') }}" />
    </label>
    <button class="km-search__submit"
            type="submit">
        <i class="{{ km_fa_icons.search }}"
           aria-hidden="true"></i>
        <span class="sr-only">{{ _("Submit search") }}</span>
    </button>
</form>
