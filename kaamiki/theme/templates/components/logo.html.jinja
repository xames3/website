{%- macro km_logo() -%}
    {%- if logo_url -%}
        <img class="km-logo km-logo--single"
             src="{{ logo_url }}"
             alt=""
             width="16"
             height="16"
             {% if km_logo_size %}style="--km-logo-size: {{ km_logo_size }}px"{% endif %} />
    {%- else -%}
        {%- if theme_dark_logo %}
            <img class="km-logo km-logo--dark"
                 src="{{ pathto('_static/' + theme_dark_logo, 1) }}"
                 alt=""
                 width="16"
                 height="16"
                 {% if km_logo_size %}style="--km-logo-size: {{ km_logo_size }}px"{% endif %} />
        {%- endif -%}
        {%- if theme_light_logo %}
            <img class="km-logo km-logo--light"
                 src="{{ pathto('_static/' + theme_light_logo, 1) }}"
                 alt=""
                 width="16"
                 height="16"
                 {% if km_logo_size %}style="--km-logo-size: {{ km_logo_size }}px"{% endif %} />
        {%- endif -%}
    {%- endif -%}
{%- endmacro -%}
