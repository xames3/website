{%- from "components/helpers.html.jinja" import km_glyph with context %}
{%- macro km_crumb(text) -%}
    <span class="km-breadcrumbs__text">{{ text }}</span>
{%- endmacro -%}
{%- set km_parent_sep = km_fa_icons.breadcrumb_separator_parent -%}
{%- set km_child_sep = km_fa_icons.breadcrumb_separator_child -%}
{%- set km_empty = "" if parents else " km-breadcrumbs--empty" -%}
<nav aria-label="{{ _('Breadcrumbs') }}"
     class="km-breadcrumbs{{ km_empty }}">
    {%- for parent in parents %}
        {%- if not loop.first %}
            {{ km_glyph(km_parent_sep if loop.index == 2 else km_child_sep) }}
        {%- endif %}
        <a class="km-breadcrumbs__link"
           href="{{ parent.link|e }}">{{- km_crumb(parent.title) -}}</a>
    {%- endfor %}
    {%- if parents %}
        {{ km_glyph(km_parent_sep if parents|length == 1 else km_child_sep) }}
        <span aria-current="page"
              class="km-breadcrumbs__current">{{- km_crumb(title) -}}</span>
    {%- endif %}
</nav>
