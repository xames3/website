{%- from "logo.html.jinja" import km_logo with context -%}
<aside id="km-sidebar"
       class="km-layout__sidebar km-sidebar km-sidebar--primary">
    <noscript>
        <a class="km-sidebar__close"
           href="#km-content">{{ _("Close menu") }}</a>
    </noscript>
    <a href="{{ pathto(master_doc) }}"
       class="km-sidebar__brand">
        {{- km_logo() -}}
        <span class="km-sidebar__brand-title">{{ (docstitle or title)|e }}{%- if km_fa_icons.title_badge %}<i class="{{ km_fa_icons.title_badge }} km-title-badge"
   aria-hidden="true"></i>{%- endif %}</span>
    </a>
    {%- if hasdoc('search') and km_show_searchbox|tobool %}
        <div class="km-sidebar__search">{%- include "searchbox.html.jinja" %}</div>
    {%- endif %}
    <div class="km-sidebar__scroll">
        <div class="km-sidebar__content">
            <nav class="km-sidebar__toc"
                 aria-label="{{ _('Table of contents') }}">
                {%- if km_show_toctree|tobool %}
                    {{ toctree(titles_only=false, collapse=false, **km_toctree_args) }}
                {%- else %}
                    {{ toctree(titles_only=true, collapse=false, **km_toctree_args) }}
                {%- endif %}
                {%- if km_sidebar_buttons|tobool %}
                    <p class="caption"
                       role="heading">
                        <span class="caption-text">{{ _("External Links") }}</span>
                    </p>
                    <ul class="km-sidebar__mobile-list">
                        {%- for text, button in km_sidebar_buttons.items() %}
                            {%- if button is mapping %}
                                <li>
                                    <a href="{{ button.url }}"
                                       title="{{ text|e }}"
                                       {% if button.new_tab %}rel="noopener nofollow" target="_blank"{% endif %}
                                       class="km-sidebar__mobile-item">
                                        {%- if button.icon %}
                                            {{ button.icon }}
                                        {%- else %}
                                            <i class="{{ km_fa_icons.external_link }}"
                                               aria-hidden="true"></i>
                                        {%- endif %}
                                        <span {{ button.extras if button.extras else '' }}>{{ text|e }}</span>
                                    </a>
                                </li>
                            {%- endif %}
                        {%- endfor %}
                    </ul>
                {%- endif %}
            </nav>
        </div>
    </div>
</aside>
