{% block km_feedback %}
    {%- set km_split = km_feedback.mode == 'split' %}
    {%- macro km_button() %}
        {%- if km_feedback.href %}
            <a href="{{ km_feedback.href|e }}"
               class="km-feedback-shell__button">
                {%- if km_feedback.icon -%}
                    <span class="{{ km_feedback.icon|e }}"
                          aria-hidden="true"></span>
                {%- endif %}
                {{ km_feedback.button|e }}
            </a>
        {%- endif %}
    {%- endmacro %}
    <div class="km-feedback-shell{% if km_split %} km-feedback-shell--split{% endif %}"
         role="complementary"
         aria-label="{{ km_feedback.title|e }}">
        {% if km_split %}
            <div class="km-feedback-shell__header--split">
                <p class="km-feedback-shell__title">{{ km_feedback.title|e }}</p>
                {{ km_button() }}
            </div>
            <p class="km-feedback-shell__subtitle">{{ km_feedback.description|e }}</p>
        {% else %}
            <div class="km-feedback-shell__inner">
                <p class="km-feedback-shell__title">{{ km_feedback.title|e }}</p>
                <p class="km-feedback-shell__subtitle">{{ km_feedback.description|e }}</p>
            </div>
            {{ km_button() }}
        {% endif %}
    </div>
{% endblock km_feedback %}
