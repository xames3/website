{% block km_button %}
    <p>
        <a class="sd-sphinx-override sd-btn sd-text-wrap {{ km_look }}{% if km_extra %} {{ km_extra }}{% endif %} reference external"
           href="{{ km_url }}"
           {{ km_anchor|xmlattr }}>
            <span>
                {%- if km_faicon and not km_faicon_after -%}
                    <span class="{{ km_faicon }}"
                          aria-hidden="true"></span>
                {%- endif -%}
                {{ km_text }}
                {%- if km_faicon and km_faicon_after -%}
                    <span class="{{ km_faicon }} km-icon-after"
                          aria-hidden="true"></span>
                {%- endif -%}
            </span>
        </a>
    </p>
{% endblock km_button %}
