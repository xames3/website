<nav aria-label="{{ _('breadcrumbs') }}"
     class="km-breadcrumbs{% if pagename == master_doc %} km-breadcrumbs--root{% endif %}">
    <a class="km-breadcrumbs__link km-breadcrumbs__link--home"
       href="{{ pathto(master_doc) }}"
       aria-label="{{ _('Home') }}">
        <i class="{{ km_fa_icons.breadcrumb_home }}"
           aria-hidden="true"></i>
    </a>
    {%- if pagename != master_doc %}<i class="{{ km_fa_icons.breadcrumb_separator_parent }}"
   aria-hidden="true"></i>{%- endif %}
    {%- for parent in parents -%}
        <a class="km-breadcrumbs__link"
           href="{{ parent.link|e }}">{{ parent.title }}</a>
        <i class="{{ km_fa_icons.breadcrumb_separator_child }}"
           aria-hidden="true"></i>
    {%- endfor -%}
    <span aria-current="page"
          class="km-breadcrumbs__current"
          id="km-currentBreadcrumb">
        {%- if pagename != master_doc %}{{ title }}{%- endif %}
        </span>
    </nav>
