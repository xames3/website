{% block author %}
    {%- set who = name|d(project.author) %}
    <aside class="site-article"
           {% if background %}data-background="{{ background }}"{% endif %}>
        <a href="{{ target|d(project.source) }}"
           target="_blank"
           rel="noopener noreferrer"
           class="site-article__profile"
           aria-label="{{ _('Check out %(name)s', name=who) }}">
            {%- if avatar|d(project.avatar) %}
                <img class="site-article__avatar"
                     src="{{ avatar|d(project.avatar) }}"
                     width="20"
                     height="20"
                     loading="lazy"
                     alt="">
            {%- endif %}
            <p class="site-article__name">{{ who }}</p>
        </a>
        <div class="site-article__meta">
            <div class="site-article__meta-group">
                <p class="site-article__reading-time">
                    <i class="{{ fa_icons.reading_time }} site-article__reading-time-icon"
                       aria-hidden="true"></i>{{ ngettext('%(num)d min read', '%(num)d mins read', minutes) }}
                </p>
                <button type="button"
                        class="site-article__copy copy-url"
                        data-tooltip="{{ _('Copy article URL to clipboard') }}">
                    <i class="{{ fa_icons.copy_url }}"
                       aria-hidden="true"></i>
                    <span>{{ _("Copy") }}</span>
                </button>
            </div>
        </div>
    </aside>
{% endblock author %}
