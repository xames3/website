{#
Searchbox Template
==================

Author: Akshay Mestry <xa@mes3.dev>
Created on: 21 February, 2025
Last updated on: 29 September, 2026

Rendered twice per page - once in the header for wide viewports and once in
the navigation drawer for narrow ones. Only the header copy answers the
Cmd+K shortcut, Ctrl+K off a Mac, which `theme.js` binds.
#}
<form action="{{ pathto('search') }}"
      method="get"
      class="km-search">
    <label class="km-search__label">
        <span class="sr-only">{{ _('Search') }}</span>
        <input class="km-search__input"
               type="search"
               name="q"
               autocomplete="on"
               placeholder="{{ _('Search') }}" />
    </label>
    <button class="km-search__submit"
            type="submit">
        <i class="{{ km_fa_icons.search }}"
           aria-hidden="true"></i>
        <span class="sr-only">{{ _("Submit search") }}</span>
    </button>
</form>
