<footer class="site-footer container">
    {%- block footer_before %}{%- endblock footer_before %}
        <div class="site-footer__inner">
            <div class="site-footer__content">
                {%- if show_copyright and copyright|length %}
                    <p class="site-footer__text">
                        {%- if hasdoc('copyright') -%}
                            {%- trans path=pathto('copyright'), copyright=copyright|e -%}
                            <a href="{{ path }}">Copyright</a> {{ copyright }}
                        {%- endtrans -%}
                    {%- else -%}
                        {{ copyright }}
                    {%- endif -%}
                </p>
            {%- endif %}
            {%- if last_updated %}
                <p class="site-footer__text">
                    {%- trans last_updated=last_updated|e -%}
                    Last updated {{ last_updated }}.
                {%- endtrans -%}
            </p>
        {%- endif %}
        {%- if show_sphinx %}
            <p class="site-footer__text">
                {%- trans -%}
                Built with <a href="https://www.sphinx-doc.org"
    rel="noreferrer">Sphinx</a>.
            {%- endtrans -%}
        </p>
    {%- endif %}
    <p class="site-footer__text">
        {% trans %}Content licensed under{% endtrans %}
        <a href="https://creativecommons.org/licenses/by/4.0/"
           rel="noopener"
           target="_blank">CC BY 4.0</a>.
    </p>
</div>
{%- if show_colour_modes|tobool %}
    <button type="button"
            class="site-footer__theme-toggle"
            aria-label="{{ _('Colour theme switcher') }}"
            @click="darkMode = darkMode === 'light' ? 'dark' : 'light'">
        <i class="{{ fa_icons.dark_mode }} site-footer__theme-toggle-icon site-footer__theme-toggle-icon--dark"
           aria-hidden="true"></i>
        <i class="{{ fa_icons.light_mode }} site-footer__theme-toggle-icon site-footer__theme-toggle-icon--light"
           aria-hidden="true"></i>
    </button>
{%- endif %}
</div>
{%- block footer_after %}{%- endblock footer_after %}
</footer>
