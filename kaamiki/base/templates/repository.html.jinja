{% block km_repository %}
    <div class="km-github-repository"
         data-km-repository="{{ km_project }}">
        <a href="https://github.com/{{ km_project }}"
           target="_blank"
           rel="noopener nofollow"
           class="km-github-repository__name">{{ km_project }}</a>
        <div class="km-github-repository__details">
            {% if km_stars %}
                <p class="km-github-repository__stars"
                   data-km-repository-count="stargazers_count">0</p>
            {% endif %}
            {% if km_forks %}
                <p class="km-github-repository__forks"
                   data-km-repository-count="forks_count">0</p>
            {% endif %}
        </div>
    </div>
{% endblock km_repository %}
