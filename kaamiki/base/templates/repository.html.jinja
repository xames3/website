{% block repository %}
    <div class="site-github-repository"
         data-repository="{{ project }}">
        <a href="https://github.com/{{ project }}"
           target="_blank"
           rel="noopener nofollow"
           class="site-github-repository__name">{{ project }}</a>
        <div class="site-github-repository__details">
            {% if stars %}
                <p class="site-github-repository__stars"
                   data-repository-count="stargazers_count">0</p>
            {% endif %}
            {% if forks %}
                <p class="site-github-repository__forks"
                   data-repository-count="forks_count">0</p>
            {% endif %}
        </div>
    </div>
{% endblock repository %}
