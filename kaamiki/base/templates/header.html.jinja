{%- from "logo.html.jinja" import site_logo with context -%}
<header class="site-header">
    {%- block header_before %}
    {% endblock header_before -%}
    <div class="site-header__inner">
        {%- block header_left %}
            <div class="site-header__primary">
                {%- block website_logo %}
                    <a href="{{ pathto(master_doc) }}"
                       class="site-header__logo">
                        {{- site_logo() -}}
                        <span class="site-header__title">{{ docstitle }}</span>
                    </a>
                {%- endblock website_logo %}
            </div>
        {%- endblock header_left %}
        {%- if show_toctree|tobool %}
            <nav class="site-header__nav"
                 aria-label="{{ _('Primary navigation') }}">
                <div class="site-header__nav-tree">
                    {{ toctree(titles_only=true, collapse=false, includehidden=true) }}
                </div>
            </nav>
        {%- endif %}
        {%- block header_right %}
            <div class="site-header__utilities">
                {%- block mobile_menu %}
                    {%- if sidebars|length > 0 %}
                        <button class="site-header__menu-toggle"
                                type="button"
                                aria-controls="sidebar"
                                :aria-expanded="showSidebar ? 'true' : 'false'"
                                @click="showSidebar = !showSidebar">
                            <i class="fa-regular fa-arrow-right-to-line"
                               aria-hidden="true"></i>
                            <span class="sr-only">{{ _("Toggle navigation menu") }}</span>
                        </button>
                    {%- endif %}
                {%- endblock mobile_menu %}
                {%- block header_buttons %}
                    {%- if header_buttons|tobool %}
                        <nav class="site-header__icon-list"
                             aria-label="{{ _('External links') }}">
                            {%- for text, url in header_buttons.items() %}
                                {%- if url is mapping %}
                                    <a href="{{ url.link }}"
                                       title="{{ text }}"
                                       rel="noopener nofollow"
                                       {% if url.link != '#' %}target="_blank"{% endif %}
                                       class="site-header__icon-link"
                                       {{ url.extras if url.extras else '' }}>
                                        {%- if url.icon %}
                                            {{ url.icon }}
                                        {%- else %}
                                            <span>{{ text }}</span>
                                        {%- endif %}
                                    </a>
                                {%- endif %}
                            {%- endfor %}
                        </nav>
                    {%- endif %}
                {%- endblock header_buttons %}
                {%- if hasdoc('search') and show_searchbox|tobool %}
                    <div class="site-header__search">
                        {%- with search_variant = "header" %}
                            {%- include "searchbox.html.jinja" %}
                        {%- endwith %}
                    </div>
                {%- endif %}
            </div>
        {%- endblock header_right %}
    </div>
    {%- block header_after %}{%- endblock header_after %}
    </header>
