{% block km_video %}
    <figure class="km-media km-media--video">
        <div class="km-media__frame">
            <video class="km-media__video"
                   controls
                   {% if km_autoplay %}autoplay muted playsinline{% endif %}>
                <source src="{{ km_url }}"
                        {% if km_type %}type="{{ km_type }}"{% endif %}>
                {{ _("Your browser does not support the video tag.") }}
            </video>
        </div>
        {%- if km_caption %}
            <figcaption class="km-media__caption">{{ km_caption }}</figcaption>
        {%- endif -%}
    </figure>
{% endblock km_video %}
