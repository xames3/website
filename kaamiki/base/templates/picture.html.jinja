{% block picture %}
    <figure class='{{ figclass | join(" ") }}{{ " align-" + align if align else "" }}'>
        {% for variant, src in [("light", light), ("dark", dark)] %}
            <img class="site-picture site-picture--{{ variant }}"
                 src="{{ src }}"
                 alt="{{ alt }}"
                 {% if width %}width="{{ width }}"{% endif %}
                 {% if height %}height="{{ height }}"{% endif %}
                 loading="lazy"
                 decoding="async" />
        {% endfor %}
        {% if caption %}
            <figcaption>
                <p>
                    <span class="caption-text">{{ caption }}</span>
                </p>
            </figcaption>
        {% endif %}
    </figure>
{% endblock picture %}
